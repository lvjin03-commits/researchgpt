{
  "name": "researchgpt",
  "version": "0.1.0",
  "description": "ResearchGPT web workspace and local connector.",
  "author": "ResearchGPT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "desktop": "electron desktop/main.cjs",
    "desktop:dir": "electron-builder --config electron-builder.local.json",
    "desktop:portable": "electron-builder --win portable --x64",
    "desktop:installer": "electron-builder --win nsis --x64",
    "desktop:publish-installer": "npm run desktop:installer && powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force public/downloads | Out-Null; Copy-Item -Force release-installer/ResearchGPT-Local-Connector-Setup.exe public/downloads/ResearchGPT-Local-Connector-Setup.exe\"",
    "build": "npm run check:document-v2-env && next build",
    "start": "next start",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:mojibake": "node scripts/check-encoding.mjs",
    "check:document-architecture": "node scripts/check-document-v2-imports.mjs",
    "check:document-diagnostics": "node scripts/check-document-v2-diagnostics-boundary.mjs",
    "check:document-production-boundaries": "node scripts/check-document-v2-production-boundaries.mjs",
    "check:research-exploration-boundaries": "node scripts/check-research-exploration-boundaries.mjs",
    "check:storm-service-boundaries": "node scripts/check-storm-service-boundaries.mjs",
    "check:grant-architecture": "node scripts/check-grant-architecture.mjs",
    "check:document-v2-env": "node scripts/check-document-v2-env.mjs",
    "analyze:document-v2-failures": "node scripts/analyze-document-v2-failures.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:document-contracts": "node --experimental-strip-types scripts/verify-document-v2-contracts.ts",
    "test:document-v2-templates": "node scripts/verify-document-v2-templates.cjs",
    "test:document-v2-generation": "node scripts/verify-document-v2-generation.cjs",
    "test:document-v2-orchestrator": "node scripts/verify-document-v2-orchestrator.cjs",
    "test:document-v2-runtime": "node scripts/verify-document-v2-runtime.cjs",
    "test:document-v2-diagnostics": "node scripts/verify-document-v2-diagnostics.cjs",
    "test:document-v2-provider-failure": "node scripts/verify-document-v2-provider-failure.cjs",
    "test:document-v2-failure-attribution": "node scripts/verify-document-v2-failure-attribution.mjs",
    "test:document-v2-structured-parser": "node scripts/verify-document-v2-structured-parser.cjs",
    "test:document-job-binding": "node scripts/verify-document-job-binding.cjs",
    "test:document-v2-docx": "node scripts/verify-document-v2-docx.cjs",
    "test:document-v2-references": "node scripts/verify-document-v2-references.cjs",
    "test:research-exploration": "node --experimental-strip-types scripts/verify-research-exploration-contracts.ts",
    "test:research-exploration-shadow": "node --experimental-strip-types scripts/verify-research-exploration-shadow.ts",
    "test:research-exploration-advisory": "node --experimental-strip-types scripts/verify-research-exploration-advisory.ts",
    "test:research-exploration-required": "node --experimental-strip-types scripts/verify-research-exploration-required.ts",
    "test:storm-runtime-off": "node --experimental-strip-types scripts/verify-storm-runtime-off.ts && node scripts/verify-document-v2-generation.cjs",
    "test:grant-foundation": "node --experimental-strip-types scripts/verify-grant-foundation-contracts.ts",
    "test:grant-foundation:postgres": "node scripts/verify-grant-foundation-postgres.mjs",
    "test:grant-editor": "node --experimental-strip-types scripts/verify-grant-editor-contracts.ts",
    "test:grant-editor:postgres": "node scripts/verify-grant-editor-postgres.mjs",
    "test:grant-diagnostics": "node --experimental-strip-types scripts/verify-grant-diagnostics-contracts.ts && node --experimental-strip-types scripts/verify-grant-real-diagnostic-checkers.ts && node --experimental-strip-types scripts/verify-grant-semantic-diagnostics.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-contracts.ts && node --experimental-strip-types scripts/verify-grant-hierarchical-diagnostic-contracts.ts && node --experimental-strip-types scripts/verify-grant-semantic-review-v6-contracts.ts && node --experimental-strip-types scripts/verify-grant-semantic-review-v6-rollout.ts && node --experimental-strip-types scripts/verify-grant-hierarchical-diagnostic-input.ts && node --experimental-strip-types scripts/verify-grant-argument-map-executor.ts && node --experimental-strip-types scripts/verify-grant-root-diagnostic-executor.ts && node --experimental-strip-types scripts/verify-grant-hierarchical-diagnostic-budget.ts && node --experimental-strip-types scripts/verify-grant-hierarchical-diagnostic-persistence.ts && node --experimental-strip-types scripts/verify-grant-hierarchical-diagnostic-rollout.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-input.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-executor.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-assembler.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-persistence.ts && node --experimental-strip-types scripts/verify-grant-semantic-v3-rollout.ts",
    "test:grant-semantic-review-v6-input": "node --experimental-strip-types scripts/verify-grant-semantic-review-v6-input.ts",
    "test:grant-semantic-review-v6:postgres": "node --experimental-strip-types scripts/verify-grant-semantic-review-v6-postgres.ts",
    "test:grant-diagnostics:postgres": "node scripts/verify-grant-diagnostics-postgres.mjs",
    "test:grant-semantic-v3:postgres": "node --experimental-strip-types scripts/verify-grant-semantic-v3-postgres.mjs",
    "test:grant-workspace-ui": "node --experimental-strip-types scripts/verify-grant-workspace-ui-contracts.ts",
    "test:grant-docx-import": "node --experimental-strip-types scripts/verify-grant-docx-import.ts",
    "test:grant-figure-assets": "node --experimental-strip-types scripts/verify-grant-figure-asset-contracts.ts && node --experimental-strip-types scripts/verify-grant-figure-authorization.ts",
    "test:grant-figure-workspace": "node --experimental-strip-types scripts/verify-grant-figure-workspace.ts",
    "test:grant-figure-assets:postgres": "node scripts/verify-grant-figure-assets-postgres.mjs",
    "test:grant-figure-authorization:postgres": "node scripts/verify-grant-figure-authorization-postgres.mjs",
    "test:grant-workspace-ui:postgres": "node scripts/verify-grant-feedback-postgres.mjs",
    "test:grant-ai-patches": "node --experimental-strip-types scripts/verify-grant-ai-patch-contracts.ts",
    "test:grant-model-execution": "node --experimental-strip-types scripts/verify-grant-model-execution.ts",
    "test:grant-assistant-chat": "node --experimental-strip-types scripts/verify-grant-assistant-chat.ts",
    "test:grant-assistant-write-boundary": "node --experimental-strip-types scripts/verify-grant-assistant-write-boundary.ts",
    "test:grant-candidate-intelligence": "node --experimental-strip-types scripts/verify-grant-candidate-intelligence-contracts.ts",
    "test:grant-candidate-diff": "node --experimental-strip-types scripts/verify-grant-candidate-diff.ts",
    "test:grant-ai-edit-sessions": "node --experimental-strip-types scripts/verify-grant-ai-edit-sessions.ts",
    "test:grant-web-sources": "node --experimental-strip-types scripts/verify-grant-web-sources.ts",
    "test:grant-ai-edit-integration": "node --experimental-strip-types scripts/verify-grant-ai-edit-integration.ts",
    "test:grant-evidence": "node --experimental-strip-types scripts/verify-grant-evidence-contracts.ts",
    "test:grant-evidence-patches": "node --experimental-strip-types scripts/verify-grant-evidence-patch-contracts.ts",
    "test:grant-pr8": "node --experimental-strip-types scripts/verify-grant-pr8-contracts.ts",
    "test:grant:ci": "npm run check:grant-architecture && npm run test:grant-foundation && npm run test:grant-editor && npm run test:grant-diagnostics && npm run test:grant-semantic-review-v6-input && npm run test:grant-workspace-ui && npm run test:grant-docx-import && npm run test:grant-figure-assets && npm run test:grant-figure-workspace && npm run test:grant-ai-patches && npm run test:grant-model-execution && npm run test:grant-assistant-chat && npm run test:grant-assistant-write-boundary && npm run test:grant-candidate-intelligence && npm run test:grant-candidate-diff && npm run test:grant-ai-edit-sessions && npm run test:grant-web-sources && npm run test:grant-ai-edit-integration && npm run test:grant-evidence && npm run test:grant-evidence-patches && npm run test:grant-pr8",
    "test:library-commands": "node --experimental-strip-types scripts/verify-library-commands.mjs",
    "test:chat-export-format-policy": "node --experimental-strip-types scripts/verify-chat-export-format-policy.ts",
    "test:point-ledger": "node --experimental-strip-types scripts/verify-point-ledger-contracts.ts",
    "test:ai-operation-contracts": "node --experimental-strip-types scripts/verify-ai-operation-contracts.ts",
    "test:point-billing-engine": "node --experimental-strip-types scripts/verify-point-billing-engine.ts",
    "test:ai-billing-integration": "node --experimental-strip-types scripts/verify-ai-billing-integration.ts",
    "test:point-payment-contracts": "node --experimental-strip-types scripts/verify-point-payment-contracts.ts",
    "test:alipay-sandbox": "node --experimental-strip-types scripts/verify-alipay-sandbox-adapter.ts",
    "test:payment-risk-controls": "node --experimental-strip-types scripts/verify-payment-risk-controls.ts",
    "test:billing-canary": "node --experimental-strip-types scripts/verify-billing-canary-and-reconciliation.ts",
    "test:account-statements": "node --experimental-strip-types scripts/verify-account-statement-contracts.ts",
    "test:account-orders-resume": "node --experimental-strip-types scripts/verify-account-orders-and-resume.ts",
    "test:account-security": "node --experimental-strip-types scripts/verify-account-security-contracts.ts",
    "test:word-visuals": "node scripts/verify-word-visuals.cjs",
    "smoke:document-v2": "node scripts/smoke-document-v2.mjs",
    "qa": "npm run check:encoding && npm run typecheck && npm run test:point-ledger && npm run test:grant-foundation && npm run test:grant-editor && npm run test:grant-diagnostics && npm run test:grant-workspace-ui && npm run test:grant-docx-import && npm run test:grant-figure-assets && npm run test:grant-figure-workspace && npm run test:grant-ai-patches && npm run test:grant-evidence && npm run test:grant-evidence-patches && npm run test:grant-pr8 && npm run test:document-job-binding && npm run test:document-v2-runtime && npm run test:document-v2-diagnostics && npm run test:document-v2-provider-failure && npm run test:document-v2-failure-attribution && npm run test:document-v2-structured-parser && npm run test:document-v2-references && npm run test:research-exploration && npm run test:research-exploration-shadow && npm run test:research-exploration-advisory && npm run test:research-exploration-required && npm run test:storm-runtime-off && npm run check:document-architecture && npm run check:document-diagnostics && npm run check:document-production-boundaries && npm run check:research-exploration-boundaries && npm run check:storm-service-boundaries && npm run check:grant-architecture && npm run build"
  },
  "build": {
    "appId": "com.researchgpt.localconnector",
    "productName": "ResearchGPT Local Connector",
    "artifactName": "ResearchGPT-Local-Connector-Setup.${ext}",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "desktop/**/*",
      "app/favicon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "executableName": "ResearchGPT Local Connector",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ResearchGPT Local Connector",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.5.18",
    "alipay-sdk": "^4.14.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
