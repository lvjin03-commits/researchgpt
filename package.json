{
  "name": "researchgpt",
  "version": "0.1.0",
  "description": "ResearchGPT web workspace and local connector.",
  "author": "ResearchGPT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "desktop": "electron desktop/main.cjs",
    "desktop:dir": "electron-builder --config electron-builder.local.json",
    "desktop:portable": "electron-builder --win portable --x64",
    "desktop:installer": "electron-builder --win nsis --x64",
    "desktop:publish-installer": "npm run desktop:installer && powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force public/downloads | Out-Null; Copy-Item -Force release-installer/ResearchGPT-Local-Connector-Setup.exe public/downloads/ResearchGPT-Local-Connector-Setup.exe\"",
    "build": "npm run check:document-v2-env && next build",
    "start": "next start",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:mojibake": "node scripts/check-encoding.mjs",
    "check:document-architecture": "node scripts/check-document-v2-imports.mjs",
    "check:document-diagnostics": "node scripts/check-document-v2-diagnostics-boundary.mjs",
    "check:document-production-boundaries": "node scripts/check-document-v2-production-boundaries.mjs",
    "check:research-exploration-boundaries": "node scripts/check-research-exploration-boundaries.mjs",
    "check:storm-service-boundaries": "node scripts/check-storm-service-boundaries.mjs",
    "check:document-v2-env": "node scripts/check-document-v2-env.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:document-contracts": "node --experimental-strip-types scripts/verify-document-v2-contracts.ts",
    "test:document-v2-templates": "node scripts/verify-document-v2-templates.cjs",
    "test:document-v2-generation": "node scripts/verify-document-v2-generation.cjs",
    "test:document-v2-orchestrator": "node scripts/verify-document-v2-orchestrator.cjs",
    "test:document-v2-runtime": "node scripts/verify-document-v2-runtime.cjs",
    "test:document-v2-diagnostics": "node scripts/verify-document-v2-diagnostics.cjs",
    "test:document-v2-provider-failure": "node scripts/verify-document-v2-provider-failure.cjs",
    "test:document-v2-structured-parser": "node scripts/verify-document-v2-structured-parser.cjs",
    "test:document-job-binding": "node scripts/verify-document-job-binding.cjs",
    "test:document-v2-docx": "node scripts/verify-document-v2-docx.cjs",
    "test:document-v2-references": "node scripts/verify-document-v2-references.cjs",
    "test:research-exploration": "node --experimental-strip-types scripts/verify-research-exploration-contracts.ts",
    "test:research-exploration-shadow": "node --experimental-strip-types scripts/verify-research-exploration-shadow.ts",
    "test:research-exploration-advisory": "node --experimental-strip-types scripts/verify-research-exploration-advisory.ts",
    "test:research-exploration-required": "node --experimental-strip-types scripts/verify-research-exploration-required.ts",
    "test:library-commands": "node --experimental-strip-types scripts/verify-library-commands.mjs",
    "test:word-visuals": "node scripts/verify-word-visuals.cjs",
    "smoke:document-v2": "node scripts/smoke-document-v2.mjs",
    "qa": "npm run check:encoding && npm run typecheck && npm run test:document-job-binding && npm run test:document-v2-runtime && npm run test:document-v2-diagnostics && npm run test:document-v2-provider-failure && npm run test:document-v2-structured-parser && npm run test:document-v2-references && npm run test:research-exploration && npm run test:research-exploration-shadow && npm run test:research-exploration-advisory && npm run test:research-exploration-required && npm run check:document-architecture && npm run check:document-diagnostics && npm run check:document-production-boundaries && npm run check:research-exploration-boundaries && npm run check:storm-service-boundaries && npm run build"
  },
  "build": {
    "appId": "com.researchgpt.localconnector",
    "productName": "ResearchGPT Local Connector",
    "artifactName": "ResearchGPT-Local-Connector-Setup.${ext}",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "desktop/**/*",
      "app/favicon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "executableName": "ResearchGPT Local Connector",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ResearchGPT Local Connector",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.5.18",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
