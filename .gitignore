# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/release
/release-local
/release-local-v2
/release-installer

# misc
.DS_Store
*.pem
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm-cache/

# env files (can opt-in for committing if needed)
.env*

# isolated STORM exploration service runtime data
/services/storm-exploration/.venv/
/services/storm-exploration/.storm-exploration-data/
/services/storm-exploration/.dist/
__pycache__/
*.py[cod]
.pytest_cache/

# generated desktop installers
/public/downloads/*.exe
/public/downloads/*.blockmap

# vercel
.vercel

# local Supabase CLI link metadata
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
